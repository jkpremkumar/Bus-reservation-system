
import java.util.*;

public class Bus {
	private int busNo;
	private boolean ac;
	private int capacity;
	Bus(int no,boolean acc,int cap){
		this.busNo=no;
		this.ac=acc;
		this.capacity=cap;
	}
	public int getcapacity(){
		return capacity;
	}
	public void setcapacity(int cap) {
		capacity=cap;
	}
	public boolean isAc(){
		return ac;
	}
	public void setAc(boolean val) {
		ac=val;
	}
	public int getbusNo(){
		return busNo;
	}
}
